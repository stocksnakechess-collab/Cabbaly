# Скопируйте этот файл в .env.local и заполните значения.
# .env.local нельзя публиковать и добавлять в Git (он уже в .gitignore).
# После изменения .env.local перезапустите `npm run dev`.

# --- Публичные значения (попадают в браузер) ---
# Supabase → Connect (или Project Settings → API): Project URL, вида https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys: «Publishable key» (начинается с sb_publishable_).
# В старых проектах это ключ «anon». Имя переменной оставлено прежним.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- СЕКРЕТНЫЕ значения: только на сервере, никогда с префиксом NEXT_PUBLIC_ ---
# Тот же раздел: «Secret key» (начинается с sb_secret_). В старых проектах это «service_role».
# Даёт полный доступ к базе — никому не показывайте!
SUPABASE_SERVICE_ROLE_KEY=

# Код для создания владельца на странице /owner-setup.
# Придумайте случайную строку не короче 16 символов. Пароль владельца здесь НЕ хранится.
OWNER_SETUP_TOKEN=

# Необязательно. Служебный домен для внутренних адресов входа (<имя>@<домен>); письма туда не отправляются.
# Если Supabase отклоняет адрес как некорректный, укажите здесь домен, которым вы владеете.
# INTERNAL_EMAIL_DOMAIN=users.cabbaly.invalid
